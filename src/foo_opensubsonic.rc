#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_OPEN_SUBSONIC_PREFERENCES DIALOGEX 0, 0, 276, 186
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "OpenSubsonic / Navidrome 服务器设置",IDC_STATIC,7,7,180,8
    LTEXT           "服务器地址:",IDC_STATIC,7,24,52,8
    EDITTEXT        IDC_OS_SERVER_URL,72,22,197,14,ES_AUTOHSCROLL
    LTEXT           "用户名:",IDC_STATIC,7,44,52,8
    EDITTEXT        IDC_OS_USERNAME,72,42,197,14,ES_AUTOHSCROLL
    LTEXT           "密码:",IDC_STATIC,7,64,52,8
    EDITTEXT        IDC_OS_PASSWORD,72,62,197,14,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "客户端名称:",IDC_STATIC,7,84,52,8
    EDITTEXT        IDC_OS_CLIENT_NAME,72,82,197,14,ES_AUTOHSCROLL
    CONTROL         "允许不安全的 TLS 连接",IDC_OS_ALLOW_INSECURE_TLS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,104,98,10
    PUSHBUTTON      "立即同步",IDC_OS_SYNC_NOW,72,123,62,14
    PUSHBUTTON      "缓存封面",IDC_OS_CACHE_ARTWORK,139,123,62,14
    PUSHBUTTON      "清除封面缓存",IDC_OS_CLEAR_ARTWORK_CACHE,72,141,94,14
    PUSHBUTTON      "清除全部缓存",IDC_OS_CLEAR_CACHE,171,141,97,14
    LTEXT           "foo_opensubsonic v0.1",IDC_OS_VERSION_TEXT,7,168,262,8
    CONTROL         "<a>https://github.com/Jokerxhub/foo_opensubsonic_zh</a>",IDC_OS_GITHUB_LINK,"SysLink",WS_TABSTOP,7,177,262,8
END
